/* CricScore — global theme.
 *
 * Palette: deep midnight navy ground, warm orange accent. Custom vars are
 * prefixed `$cs-` to avoid clashing with Textual's built-in design tokens
 * (e.g. `$panel` is a Textual reserved color used by internal widgets).
 */

$cs-accent: #f59f3a;
$cs-accent-dim: #b87425;
$cs-surface: #0f1622;
$cs-panel: #182232;
$cs-panel-soft: #1f2c40;
$cs-text-soft: #9aa6bd;
$cs-text-mute: #5b6981;
$cs-danger: #f05a5a;
$cs-success: #5dd39e;

Screen {
    background: $cs-surface;
}

/* ---------- LoadingScreen ---------- */

LoadingScreen {
    align: center middle;
}

LoadingScreen #loading-card {
    width: 60;
    height: 9;
    border: round $cs-accent;
    padding: 1 2;
    background: $cs-panel;
    align: center middle;
    content-align: center middle;
}

LoadingScreen #loading-status {
    color: $cs-text-soft;
    text-align: center;
    margin-top: 1;
}

LoadingScreen LoadingIndicator {
    color: $cs-accent;
    height: 1;
}

LoadingScreen #loading-error {
    color: $cs-danger;
    text-align: center;
    margin-top: 1;
    display: none;
}

LoadingScreen.errored #loading-error {
    display: block;
}

LoadingScreen.errored LoadingIndicator {
    display: none;
}

/* ---------- URLInputScreen ---------- */

URLInputScreen {
    align: center middle;
}

URLInputScreen #url-card {
    width: 80;
    height: 11;
    border: round $cs-accent;
    padding: 1 2;
    background: $cs-panel;
}

URLInputScreen #url-title {
    color: $cs-accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

URLInputScreen #url-input {
    border: tall $cs-panel-soft;
    background: $cs-surface;
}

URLInputScreen #url-error {
    color: $cs-danger;
    text-align: center;
    margin-top: 1;
    display: none;
}

URLInputScreen.errored #url-error {
    display: block;
}

URLInputScreen #url-hint {
    color: $cs-text-mute;
    text-align: center;
    margin-top: 1;
}

/* ---------- ScorecardScreen ---------- */

ScorecardScreen {
    layout: vertical;
}

MatchHeader {
    height: auto;
    border: round $cs-accent-dim;
    padding: 1 2;
    background: $cs-panel;
    margin: 1 2 0 2;
}

MatchHeader .match-title,
MatchHeader .match-status,
MatchHeader .match-venue,
MatchHeader .match-team,
MatchHeader .match-sparkline,
MatchHeader .match-award {
    height: 1;
}

MatchHeader .match-spacer {
    height: 1;
}

MatchHeader .logos-row {
    align: center middle;
    height: auto;
    width: 1fr;
    margin-bottom: 1;
}

MatchHeader .team-logo {
    width: auto;
    height: auto;
}

MatchHeader .logos-vs {
    width: 4;
    height: auto;
    content-align: center middle;
    margin: 0 2;
}

/* ---------- LivePanel (replaces MatchHeader when match is LIVE) ---------- */

LivePanel {
    height: auto;
    border: round $cs-accent;
    background: $cs-panel;
    margin: 1 2 0 2;
}

LivePanel #live-left {
    height: auto;
    width: 3fr;
    padding: 1 2;
}

LivePanel #live-right {
    height: auto;
    width: 2fr;
    padding: 1 2;
    border-left: solid $cs-panel-soft;
    align: center top;
}

LivePanel .live-status {
    height: 1;
    margin-bottom: 1;
}

LivePanel .live-score {
    height: 1;
    margin-bottom: 1;
}

LivePanel .live-over {
    height: 1;
    color: $cs-text-soft;
    margin-bottom: 1;
}

LivePanel .live-section-label {
    height: 1;
    margin-top: 1;
}

LivePanel .live-batter {
    height: 1;
}

LivePanel .live-bowler {
    height: 1;
}

LivePanel .live-context {
    height: 1;
    margin-top: 1;
    color: $cs-text-soft;
}

/* ── Over chip tile display (right column) ── */

LivePanel .over-info {
    width: 1fr;
    height: 2;
    content-align: center middle;
    text-align: center;
    margin-bottom: 1;
}

LivePanel #over-chips-wrap {
    height: auto;
    width: 1fr;
    align: center top;
}

LivePanel .over-chips-row {
    height: auto;
    width: auto;
    margin-bottom: 1;
}

LivePanel .ball-chip {
    width: 7;
    height: 3;
    content-align: center middle;
    margin: 0 1;
    text-style: bold;
}

LivePanel .chip-dot {
    border: round $cs-text-mute;
    color: $cs-text-mute;
}

LivePanel .chip-wicket {
    background: $cs-danger;
    border: round $cs-danger;
    color: white;
}

LivePanel .chip-boundary {
    background: $cs-accent;
    border: round $cs-accent;
    color: $cs-surface;
}

LivePanel .chip-extra {
    border: round $cs-text-soft;
    color: $cs-text-soft;
}

LivePanel .chip-run {
    border: round $cs-success;
    color: $cs-success;
}

TabbedContent {
    height: 2fr;
    margin: 1 2 0 2;
}

TabPane {
    padding: 0 1;
}

InningsPanel {
    layout: vertical;
    height: 1fr;
}

InningsPanel .section-heading {
    color: $cs-accent;
    text-style: bold;
    margin-top: 1;
}

DataTable {
    background: $cs-panel;
    height: auto;
    margin-top: 0;
}

DataTable > .datatable--header {
    background: $cs-panel-soft;
    color: $cs-accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $cs-accent-dim;
}

FowStrip {
    height: auto;
    color: $cs-text-soft;
    background: $cs-panel;
    border: round $cs-panel-soft;
    padding: 0 1;
    margin-top: 1;
    layout: horizontal;
}

FowStrip.empty {
    display: none;
}

FowStrip .fow-heading {
    width: auto;
    height: 1;
}

FowStrip .fow-line {
    width: 1fr;
    height: 1;
}

/* ---------- CommentaryPanel (live matches only) ---------- */

CommentaryPanel {
    height: 1fr;
    margin: 1 2 1 2;
    border: round $cs-accent-dim;
    background: $cs-panel;
    overflow-y: auto;
}

CommentaryPanel .commentary-heading {
    color: $cs-accent;
    text-style: bold;
    margin: 0 0 1 2;
}

CommentaryPanel .commentary-item {
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
}

CommentaryPanel .newly-arrived {
    background: $cs-accent 15%;
}

Footer {
    background: $cs-panel;
}
